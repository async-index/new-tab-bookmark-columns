{
  "manifest_version": 3,
  "name": "New Tab Bookmark Columns",
  "version": "1.1.1",
  "description": "A clean new tab page showing your bookmarks in resizable columns.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["bookmarks", "storage", "favicon"],
  "icons": {
    "16": "icons/icon-light-16.png",
    "32": "icons/icon-light-32.png",
    "48": "icons/icon-light-48.png",
    "128": "icons/icon-light-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-light-16.png",
      "32": "icons/icon-light-32.png",
      "48": "icons/icon-light-48.png",
      "128": "icons/icon-light-128.png"
    }
  }
}
